import csv
def share(f, a, b):
    rows = [x for x in csv.DictReader(open(f)) if a <= int(x[\"second\"]) < b]
    c = sum(int(x[\"canary\"]) for x in rows); p = sum(int(x[\"primary\"]) for x in rows); e = sum(int(x[\"canary_err\"]) for x in rows)
    return f\"canary={c} primary={p} share={100*c/(c+p):.2f}% canary_5xx={e}\"
